{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathIgnorePatterns=\\.db\\.spec\\.ts$",
    "test:db": "node ../scripts/require-test-database.mjs",
    "worker:dev": "tsx watch src/worker.ts",
    "worker": "node dist/worker.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:showcase": "node --env-file=.env --import tsx prisma/seed-showcase.ts",
    "db:seed:check": "tsc --project prisma/tsconfig.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/platform-socket.io": "10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "10.4.22",
    "@prisma/client": "^6.19.0",
    "@syrian-marketplace/contracts": "0.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "socket.io": "^4.8.1",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "10.4.22",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "^22.18.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "3.4.0",
    "jest": "^29.7.0",
    "prisma": "^6.19.0",
    "socket.io-client": "4.8.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6"
  }
}
