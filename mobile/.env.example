# Public connection URLs only. Android emulator: replace localhost with 10.0.2.2.
# Physical phones need a reachable LAN host; shared APK testing should use HTTPS.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_WS_URL=http://localhost:4000/orders
# Actual team-owned EAS project UUID, required only for native push registration.
EXPO_PUBLIC_PROJECT_ID=replace-with-expo-project-id

# Public native map style; requires an SDK 54 development build with MapLibre.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
