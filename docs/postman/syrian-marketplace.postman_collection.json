{
  "info": {
    "name": "Syrian Marketplace - Setup API",
    "description": "Only implemented infrastructure routes. Add every business route, auth, bodies and examples with each slice. No business endpoint is implemented yet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Infrastructure",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Process liveness; does not test PostgreSQL readiness. Simulator indicator describes the planned release."
          },
          "response": [
            {
              "name": "Setup shell alive",
              "originalRequest": { "method": "GET", "header": [], "url": "{{baseUrl}}/health" },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"status\": \"ok\",\n  \"phase\": \"setup\",\n  \"simulatedPayments\": true\n}"
            }
          ]
        }
      ]
    }
  ]
}
