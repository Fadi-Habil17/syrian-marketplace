NODE_ENV=development
PORT=4000
WEB_ORIGINS=http://localhost:3000
# Match root Compose credentials. Port 15432 avoids an existing native PostgreSQL service.
DATABASE_URL=postgresql://marketplace_local:replace-with-local-password@127.0.0.1:15432/marketplace_dev?schema=public
# Only enable fictional seed on an isolated nonproduction database.
ALLOW_DEMO_SEED=false
# Explicit separate database for PostgreSQL integration tests; never production.
DATABASE_TEST_URL=postgresql://marketplace_local:replace-with-local-password@127.0.0.1:15432/marketplace_test?schema=public
# Independent random secrets, at least 32 characters; never reuse these placeholders.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-different-at-least-32-random-bytes
# Access 900s, refresh 30d and bcrypt cost 12 are fixed security policy.
# Required in production; encrypts pending verification/reset mail in the outbox.
EMAIL_OUTBOX_KEY=replace-with-independent-at-least-32-random-bytes
# Development delivers private files here, outside public web roots. Keep ignored.
LOCAL_MAIL_DIR=.local-data/mail
# Production authenticated HTTP email adapter; supports stable Idempotency-Key.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=
PAYMENT_PROVIDER=simulated
WORKER_POLL_MS=1000
# Private S3-compatible storage, authenticated SeaweedFS in local Compose.
STORAGE_ENDPOINT=http://127.0.0.1:19000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=marketplace-private
STORAGE_ACCESS_KEY=replace-with-local-storage-user
STORAGE_SECRET_KEY=replace-with-local-storage-password
STORAGE_FORCE_PATH_STYLE=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=13310
# Enable after configuring real Expo project/device tokens. In-app notices always persist.
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
