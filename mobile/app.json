{
  "expo": {
    "name": "Syrian Marketplace",
    "slug": "syrian-marketplace",
    "version": "0.1.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "locales": {
      "ar": {
        "ios": {
          "NSLocationWhenInUseUsageDescription": "استخدم موقعك مرة واحدة لتحديد دبوس العنوان أو للعثور على أنشطة قريبة.",
          "NSPhotoLibraryUsageDescription": "اختر صورة لإرفاقها بطلب المعاينة."
        }
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syrianmarketplace.app"
    },
    "android": {
      "package": "com.syrianmarketplace.app"
    },
    "extra": {
      "supportsRTL": true
    },
    "scheme": "dukkanhara",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to attach to your inspection request.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "Use your location once to place a pin or find nearby businesses."
        }
      ]
    ]
  }
}
