// Canonical relational model. SQL-only invariants live in the subsequent
// domain_constraints migration; do not replace migrations with db push.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SetupMetadata {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

enum RoleCode {
  CUSTOMER
  FREELANCER
  PROFESSIONAL
  STORE_OWNER
  DELIVERY_DRIVER
  ADMIN
}

enum BusinessType {
  FREELANCER
  PROFESSIONAL
  STORE_OWNER
  DELIVERY_DRIVER
}

enum ProfileStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  SUSPENDED
}

enum Workspace {
  FREELANCE
  PROFESSIONALS
  HOME_STORE
}

enum Currency {
  SYP
  USD
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  INACTIVE
  HIDDEN
}

enum ListingKind {
  FREELANCE
  PROFESSIONAL_PACKAGE
}

enum OrderState {
  DRAFT
  AWAITING_AGREEMENT
  BOOKING_REQUESTED
  SCHEDULE_PROPOSED
  PENDING_QUOTE
  QUOTE_SENT
  APPROVED
  AWAITING_DEPOSIT
  DEPOSIT_HELD
  IN_PROGRESS
  EN_ROUTE
  ON_SITE
  READY_FOR_FINAL_PAYMENT
  FINAL_PAYMENT_OVERDUE
  FULLY_FUNDED
  PAID_IN_ESCROW
  PREPARING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_EXCEPTION
  DELIVERY_REVIEW_REQUIRED
  CANCELLATION_PENDING
  EXTENSION_PENDING
  DISPUTED
  REVISION_IN_PROGRESS
  RESOLVED
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
  REFUNDED
}

enum ServiceKind {
  FREELANCE
  FIXED_BOOKING
  INSPECTION_QUOTE
}

enum BookingState {
  REQUESTED
  COUNTER_PROPOSED
  CONFIRMED
  REJECTED
  EXPIRED
}

enum QuoteState {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum ReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

enum FileAccessClass {
  PUBLIC_CATALOG
  ORDER_SHARED
  FINAL_DELIVERABLE
  DELIVERY_ONLY
  CASE_EVIDENCE
}

enum ScanStatus {
  QUARANTINED
  CLEAN
  REJECTED
  DELETED
}

enum PortfolioKind {
  IMAGE
  FILE
  LINK
}

enum SubmissionKind {
  READINESS
  DIGITAL_FINAL
  ONSITE_HANDOVER
}

enum AccountKind {
  AVAILABLE
  ESCROW
  COMMISSION
  SIMULATOR_CLEARING
}

enum JournalKind {
  SIMULATED_TOPUP
  DEPOSIT_HOLD
  BALANCE_HOLD
  STORE_HOLD
  DELIVERY_ADJUSTMENT_HOLD
  DELIVERY_ADJUSTMENT_REFUND
  SETTLEMENT
}

enum Installment {
  DEPOSIT
  BALANCE
  FULL
  DELIVERY_ADJUSTMENT
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
}

enum EscrowStatus {
  OPEN
  FROZEN
  SETTLED
}

enum AllocationKind {
  BUYER_REFUND
  SELLER_NET
  SELLER_DELIVERY
  DRIVER_PAYOUT
  COMMISSION
}

enum SettlementMode {
  BUYER_CONFIRMATION
  AUTO_COMPLETION
  ADMIN_RESOLUTION
  MUTUAL_CANCELLATION
  PROVIDER_CANCEL
  PRESTART_CANCEL
  STORE_DECLINE
  STORE_TIMEOUT
  UNFULFILLABLE
}

enum DeliveryMethod {
  SELLER
  PLATFORM_DRIVER
}

enum DeliveryStatus {
  PENDING
  REQUESTED
  ASSIGNED
  PICKED_UP
  DROPPED_OFF
  EXCEPTION
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  PICKED_UP
  COMPLETED
  RELEASED
  CANCELLED
}

enum DeliveryEventType {
  REQUESTED
  ASSIGNED
  RELEASED
  PICKUP
  DROPOFF
  EXCEPTION
  REASSIGNED
}

enum CaseKind {
  DISPUTE
  CANCELLATION
  FINAL_PAYMENT_OVERDUE
  DELIVERY_REVIEW
  SUPPORT
}

enum CaseStatus {
  OPEN
  ADMIN_REVIEW
  REVISION_ACCEPTED
  RESOLVED
}

enum EvidenceVisibility {
  SHARED
  PRIVATE_ADMIN
}

enum ProposalKind {
  CANCELLATION_SPLIT
  REVISION
  EXTENSION
  DELIVERY_REMEDY
}

enum ApprovalDecision {
  ACCEPT
  REJECT
}

enum RoomKind {
  ORDER_SHARED
  DELIVERY
}

enum NotificationChannel {
  IN_APP
  PUSH
  WEBSOCKET
}

enum DeliveryAttemptStatus {
  PENDING
  SENT
  FAILED
  DISABLED
}

enum DevicePlatform {
  IOS
  ANDROID
}

enum RestrictionKind {
  SUSPENSION
  PURCHASING
  PUBLISHING
  MESSAGING
}

enum VerificationKind {
  PASSWORD_RESET
  REALTIME_TICKET
}

enum ModerationOutcome {
  APPROVE
  HIDE
  REJECT
  RESTORE
}

enum JobStatus {
  READY
  RUNNING
  DONE
  FAILED
}

enum JobKind {
  SERVICE_DUE
  RESPONSE_EXPIRY
  DEPOSIT_EXPIRY
  BALANCE_REMINDER_24
  BALANCE_REMINDER_48
  BALANCE_EXPIRY
  STORE_ACCEPTANCE_EXPIRY
  CANCELLATION_EXPIRY
  EVIDENCE_EXPIRY
  DELIVERY_REVIEW
  DISPATCH_ESCALATION
}

model User {
  id                               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                            String                  @unique @db.VarChar(254)
  passwordHash                     String                  @db.VarChar(100)
  displayName                      String                  @db.VarChar(120)
  locale                           String                  @default("ar") @db.VarChar(2)
  archivedAt                       DateTime?               @db.Timestamptz(3)
  createdAt                        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                        DateTime                @updatedAt @db.Timestamptz(3)
  userRole_user                    UserRole[]              @relation("UserRole_user")
  session_user                     Session[]               @relation("Session_user")
  verificationToken_user           VerificationToken[]     @relation("VerificationToken_user")
  restriction_user                 Restriction[]           @relation("Restriction_user")
  restriction_admin                Restriction[]           @relation("Restriction_admin")
  address_user                     Address[]               @relation("Address_user")
  businessProfile_user             BusinessProfile[]       @relation("BusinessProfile_user")
  fileAsset_owner                  FileAsset[]             @relation("FileAsset_owner")
  moderationDecision_admin         ModerationDecision[]    @relation("ModerationDecision_admin")
  commissionRate_admin             CommissionRate[]        @relation("CommissionRate_admin")
  marketOrder_buyer                MarketOrder[]           @relation("MarketOrder_buyer")
  submission_actor                 Submission[]            @relation("Submission_actor")
  stockReconciliation_actor        StockReconciliation[]   @relation("StockReconciliation_actor")
  orderTransition_actor            OrderTransition[]       @relation("OrderTransition_actor")
  ledgerAccount_user               LedgerAccount[]         @relation("LedgerAccount_user")
  wallet_user                      Wallet[]                @relation("Wallet_user")
  ledgerJournal_actor              LedgerJournal[]         @relation("LedgerJournal_actor")
  paymentAttempt_actor             PaymentAttempt[]        @relation("PaymentAttempt_actor")
  idempotencyRecord_actor          IdempotencyRecord[]     @relation("IdempotencyRecord_actor")
  deliveryRate_admin               DeliveryRate[]          @relation("DeliveryRate_admin")
  deliveryTermsRevision_proposedBy DeliveryTermsRevision[] @relation("DeliveryTermsRevision_proposedBy")
  deliveryEvent_actor              DeliveryEvent[]         @relation("DeliveryEvent_actor")
  caseRecord_opener                CaseRecord[]            @relation("CaseRecord_opener")
  caseRecord_handlingAdmin         CaseRecord[]            @relation("CaseRecord_handlingAdmin")
  caseParty_user                   CaseParty[]             @relation("CaseParty_user")
  caseEvidence_submitter           CaseEvidence[]          @relation("CaseEvidence_submitter")
  resolutionProposal_proposedBy    ResolutionProposal[]    @relation("ResolutionProposal_proposedBy")
  proposalApproval_user            ProposalApproval[]      @relation("ProposalApproval_user")
  adminDecision_admin              AdminDecision[]         @relation("AdminDecision_admin")
  chatMessage_sender               ChatMessage[]           @relation("ChatMessage_sender")
  review_buyer                     Review[]                @relation("Review_buyer")
  reviewVersion_actor              ReviewVersion[]         @relation("ReviewVersion_actor")
  notification_user                Notification[]          @relation("Notification_user")
  deviceToken_user                 DeviceToken[]           @relation("DeviceToken_user")
  auditRecord_actor                AuditRecord[]           @relation("AuditRecord_actor")

  @@index([createdAt, id])
}

model Role {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          RoleCode   @unique
  name          String     @db.VarChar(80)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  userRole_role UserRole[] @relation("UserRole_role")
}

model UserRole {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  userId    String    @db.Uuid
  roleId    String    @db.Uuid
  user      User      @relation("UserRole_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role      Role      @relation("UserRole_role", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
}

model Session {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  refreshHash  String    @unique @db.VarChar(128)
  familyId     String    @db.Uuid
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid
  client       String    @db.VarChar(16)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  userId       String    @db.Uuid
  user         User      @relation("Session_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacedBy   Session?  @relation("SessionReplacement", fields: [replacedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replaces     Session[] @relation("SessionReplacement")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

model VerificationToken {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       VerificationKind
  tokenHash  String           @unique @db.VarChar(128)
  expiresAt  DateTime         @db.Timestamptz(3)
  consumedAt DateTime?        @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  userId     String           @db.Uuid
  user       User             @relation("VerificationToken_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, kind])
  @@index([expiresAt])
}

model Restriction {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      RestrictionKind
  reason    String          @db.Text
  expiresAt DateTime?       @db.Timestamptz(3)
  revokedAt DateTime?       @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  userId    String          @db.Uuid
  adminId   String          @db.Uuid
  user      User            @relation("Restriction_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  admin     User            @relation("Restriction_admin", fields: [adminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([adminId])
}

model Country {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String        @unique @db.VarChar(2)
  nameAr              String
  nameEn              String
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  governorate_country Governorate[] @relation("Governorate_country")
}

model Governorate {
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isoCode                String       @unique @db.VarChar(5)
  nameAr                 String
  nameEn                 String
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(3)
  countryId              String       @db.Uuid
  country                Country      @relation("Governorate_country", fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  city_governorate       City[]       @relation("City_governorate")
  driverZone_governorate DriverZone[] @relation("DriverZone_governorate")

  @@index([countryId])
}

model City {
  centerLatitude Float?
  centerLongitude Float?
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr               String
  nameEn               String
  isDistrict           Boolean           @default(false)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)
  governorateId        String            @db.Uuid
  governorate          Governorate       @relation("City_governorate", fields: [governorateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  area_city            Area[]            @relation("Area_city")
  address_city         Address[]         @relation("Address_city")
  businessProfile_city BusinessProfile[] @relation("BusinessProfile_city")
  serviceArea_city     ServiceArea[]     @relation("ServiceArea_city")
  driverZone_city      DriverZone[]      @relation("DriverZone_city")
  storefront_city      Storefront[]      @relation("Storefront_city")
  deliveryRate_city    DeliveryRate[]    @relation("DeliveryRate_city")
  delivery_city        Delivery[]        @relation("Delivery_city")

  @@unique([id, governorateId])
  @@unique([governorateId, nameEn])
}

model Area {
  centerLatitude Float?
  centerLongitude Float?
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr           String
  nameEn           String
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  cityId           String        @db.Uuid
  city             City          @relation("Area_city", fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  address_area     Address[]     @relation("Address_area")
  serviceArea_area ServiceArea[] @relation("ServiceArea_area")
  delivery_area    Delivery[]    @relation("Delivery_area")

  @@unique([id, cityId])
  @@unique([cityId, nameEn])
}

model Address {
  latitude                  Float?
  longitude                 Float?
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label                     String
  details                   String              @db.Text
  contactName               String
  contactPhone              String
  archivedAt                DateTime?           @db.Timestamptz(3)
  createdAt                 DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime            @updatedAt @db.Timestamptz(3)
  userId                    String              @db.Uuid
  cityId                    String              @db.Uuid
  areaId                    String?             @db.Uuid
  user                      User                @relation("Address_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  city                      City                @relation("Address_city", fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  area                      Area?               @relation("Address_area", fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  inspectionRequest_address InspectionRequest[] @relation("InspectionRequest_address")

  @@index([userId, archivedAt])
  @@index([cityId])
  @@index([areaId])
}

model BusinessProfile {
  venueLatitude Float?
  venueLongitude Float?
  venuePublished Boolean @default(false)
  id                           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                         BusinessType
  status                       ProfileStatus         @default(DRAFT)
  title                        String
  bio                          String                @db.Text
  trade                        String?
  experienceYears              Int?
  ratingAverage                Float?
  reviewCount                  Int                   @default(0)
  archivedAt                   DateTime?             @db.Timestamptz(3)
  createdAt                    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime              @updatedAt @db.Timestamptz(3)
  userId                       String                @db.Uuid
  cityId                       String?               @db.Uuid
  user                         User                  @relation("BusinessProfile_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  city                         City?                 @relation("BusinessProfile_city", fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  profileSkill_profile         ProfileSkill[]        @relation("ProfileSkill_profile")
  profileLanguage_profile      ProfileLanguage[]     @relation("ProfileLanguage_profile")
  serviceArea_profile          ServiceArea[]         @relation("ServiceArea_profile")
  driverZone_profile           DriverZone[]          @relation("DriverZone_profile")
  portfolioItem_profile        PortfolioItem[]       @relation("PortfolioItem_profile")
  listing_profile              Listing[]             @relation("Listing_profile")
  storefront_profile           Storefront?           @relation("Storefront_profile")
  moderationDecision_profile   ModerationDecision[]  @relation("ModerationDecision_profile")
  marketOrder_sellerProfile    MarketOrder[]         @relation("MarketOrder_sellerProfile")
  scheduleReservation_provider ScheduleReservation[] @relation("ScheduleReservation_provider")
  driverAssignment_driver      DriverAssignment[]    @relation("DriverAssignment_driver")
  review_sellerProfile         Review[]              @relation("Review_sellerProfile")

  @@unique([id, userId])
  @@index([type, status, cityId])
  @@index([userId, status])
  @@index([cityId])
  @@index([status, ratingAverage, id])
}

model ProfileSkill {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String          @db.VarChar(100)
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  profileId String          @db.Uuid
  profile   BusinessProfile @relation("ProfileSkill_profile", fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([profileId, name])
}

model ProfileLanguage {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  languageCode String          @db.VarChar(10)
  proficiency  String          @db.VarChar(40)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  profileId    String          @db.Uuid
  profile      BusinessProfile @relation("ProfileLanguage_profile", fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([profileId, languageCode])
}

model ServiceArea {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @db.Timestamptz(3)
  profileId String          @db.Uuid
  cityId    String          @db.Uuid
  areaId    String?         @db.Uuid
  profile   BusinessProfile @relation("ServiceArea_profile", fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  city      City            @relation("ServiceArea_city", fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  area      Area?           @relation("ServiceArea_area", fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([profileId, cityId, areaId])
  @@index([cityId, areaId])
  @@index([areaId])
}

model DriverZone {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  profileId     String          @db.Uuid
  governorateId String          @db.Uuid
  cityId        String?         @db.Uuid
  profile       BusinessProfile @relation("DriverZone_profile", fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  governorate   Governorate     @relation("DriverZone_governorate", fields: [governorateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  city          City?           @relation("DriverZone_city", fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([profileId, governorateId, cityId])
  @@index([governorateId, cityId])
  @@index([cityId])
}

model FileAsset {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey             String              @unique
  originalName           String              @db.VarChar(255)
  mimeType               String              @db.VarChar(100)
  extension              String              @db.VarChar(12)
  sizeBytes              BigInt
  sha256                 String?             @db.VarChar(64)
  accessClass            FileAccessClass
  scanStatus             ScanStatus          @default(QUARANTINED)
  deletedAt              DateTime?           @db.Timestamptz(3)
  retainUntil            DateTime?           @db.Timestamptz(3)
  legalHold              Boolean             @default(false)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)
  ownerId                String              @db.Uuid
  orderId                String?             @db.Uuid
  caseId                 String?             @db.Uuid
  owner                  User                @relation("FileAsset_owner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order                  MarketOrder?        @relation("FileAsset_order", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  case                   CaseRecord?         @relation("FileAsset_case", fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  portfolioItem_file     PortfolioItem[]     @relation("PortfolioItem_file")
  listingAsset_file      ListingAsset[]      @relation("ListingAsset_file")
  storefront_logo        Storefront[]        @relation("Storefront_logo")
  productAsset_file      ProductAsset[]      @relation("ProductAsset_file")
  inspectionPhoto_file   InspectionPhoto[]   @relation("InspectionPhoto_file")
  submission_file        Submission[]        @relation("Submission_file")
  deliveryEvent_proof    DeliveryEvent[]     @relation("DeliveryEvent_proof")
  caseEvidence_file      CaseEvidence[]      @relation("CaseEvidence_file")
  messageAttachment_file MessageAttachment[] @relation("MessageAttachment_file")

  @@index([ownerId, createdAt])
  @@index([orderId, accessClass])
  @@index([scanStatus])
  @@index([retainUntil])
  @@index([caseId])
}

model PortfolioItem {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       PortfolioKind
  title      String
  caption    String?
  url        String?
  position   Int             @default(0)
  archivedAt DateTime?       @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
  profileId  String          @db.Uuid
  fileId     String?         @db.Uuid
  profile    BusinessProfile @relation("PortfolioItem_profile", fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  file       FileAsset?      @relation("PortfolioItem_file", fields: [fileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([profileId, position])
  @@index([fileId])
}

model Category {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace        Workspace
  nameAr           String
  nameEn           String
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)
  parentId         String?    @db.Uuid
  parent           Category?  @relation("Category_parent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category_parent  Category[] @relation("Category_parent")
  listing_category Listing[]  @relation("Listing_category")
  product_category Product[]  @relation("Product_category")

  @@index([workspace, active])
  @@index([parentId])
}

model Listing {
  id                         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                       ListingKind
  titleAr                    String
  titleEn                    String
  descriptionAr              String               @db.Text
  descriptionEn              String               @db.Text
  currency                   Currency
  priceUnits                 BigInt
  deliveryDays               Int?
  durationMinutes            Int?
  status                     PublicationStatus    @default(DRAFT)
