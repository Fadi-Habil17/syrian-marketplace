NODE_ENV=development
PORT=4000
WEB_ORIGINS=http://localhost:3000
# Match root Docker credentials. Keep this file as a template.
DATABASE_URL=postgresql://marketplace_local:replace-with-local-password@localhost:5432/syrian_marketplace?schema=public
# Future domain/session adapters consume these values; not active in setup shell.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-different-at-least-32-random-bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12
PAYMENT_PROVIDER=simulated
WORKER_POLL_MS=30000
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=marketplace-private
STORAGE_ACCESS_KEY=replace-with-local-storage-user
STORAGE_SECRET_KEY=replace-with-local-storage-password
STORAGE_FORCE_PATH_STYLE=true
EXPO_ACCESS_TOKEN=replace-only-if-push-project-requires-it
