# Server-only backend address. Never expose bearer credentials here.
NEST_API_URL=http://localhost:4000/api/v1
# Public Socket.IO namespace URL. Browser credentials come from a scoped server action.
NEXT_PUBLIC_WS_URL=http://localhost:4000/orders

# Optional approved marketplace film. Leave empty to keep the image-first story without a play button.
NEXT_PUBLIC_MARKETPLACE_FILM_URL=
# Bundled original silent walkthrough is used when unset.
NEXT_PUBLIC_PRODUCT_TOUR_URL=/media/product-tour.webm
